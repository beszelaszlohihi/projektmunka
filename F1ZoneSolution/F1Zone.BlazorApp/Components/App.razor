<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>F1Zone</title>
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="F1Zone.BlazorApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        
        window.setupStrategyChart = (laps, times, lineColors) => {

            
            const canvas = document.getElementById('strategyChart');
            if (!canvas) return; 

            // Lekérjük a 2D-s rajzolási kontextust a canvashoz, enélkül nem lehet rajzolni rá.
            const ctx = canvas.getContext('2d');

            // Ha már létezik egy korábban megrajzolt diagram, azt először megsemmisítjük.
            if (window.myChart) {
                window.myChart.destroy();
            }

            // Színek beállítása
            const colors = Array.isArray(lineColors) ? lineColors : ['#ff1801'];
            const backgrounds = colors.map(c => c.includes("rgba") ? c.replace("1)", "0.2)") : "rgba(255,24,1,0.2)");

            
            window.myChart = new Chart(ctx, {
                type: 'line', 
                data: {
                    labels: laps, 
                    datasets: [{
                        label: 'Köridő (mp)', 
                        data: times,          
                        borderColor: colors,  
                        backgroundColor: backgrounds, 
                        borderWidth: 3,       
                        pointRadius: 3,       
                        pointBackgroundColor: colors, 
                        tension: 0.3,         

                        //a vonal színe szakaszonként (pontonként) meg tud változni.
                        segment: {
                            borderColor: ctx => colors[ctx.p1DataIndex] || colors[0]
                        }
                    }]
                },
                options: {
                    responsive: true, 
                    maintainAspectRatio: false, // Engedjük, hogy a diagram doboza szabadon nyújtható legyen
                    scales: {
                        y: {
                            grid: { color: '#333' }, 
                            ticks: { color: 'white' } 
                        },
                        x: {
                            grid: { display: false }, 
                            ticks: { color: 'white' } 
                        }
                    },
                    plugins: {
                        legend: { display: false } 
                    }
                }
            });
        };
    </script>

    <script src="_framework/blazor.web.js"></script>
</body>

</html>
