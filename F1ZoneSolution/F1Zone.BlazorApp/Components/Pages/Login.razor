@page "/login"
@using F1ZoneLibrary.Dto
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="f1-body login-page">
    <div class="login-card">
        <div class="login-header">
            <a href="/" class="logo">F1<span>ZONE</span></a>
            <h2>Bejelentkezés</h2>
            <p>Lépj be a profilodba a teljes élményért!</p>
        </div>

        @* Bejelentkezési űrlap, amely sikeres validáció után meghívja a login kezelő metódust *@
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <div class="form-group">
                <label>Email cím</label>
                <input type="email" @bind-value="loginModel.Email" placeholder="pelda@email.com" required />
            </div>

            <div class="form-group">
                <label>Jelszó</label>
                <input type="password" @bind-value="loginModel.Password" placeholder="••••••••" required />
            </div>

            @* Sikertelen bejelentkezés esetén hibaüzenet megjelenítése *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-msg">@errorMessage</div>
            }

            <button type="submit" class="hero-btn">BEJELENTKEZÉS</button>
        </EditForm>

        @* Navigáció a regisztrációs oldalra új felhasználók számára *@
        <div class="login-footer">
            <p>Nincs még fiókod? <a href="/register">Regisztráció</a></p>
        </div>
    </div>
</div>

@code {

    // A bejelentkezési űrlap adatait tároló modell
    private LoginDto loginModel = new LoginDto();

    // Hibaüzenet tárolása sikertelen bejelentkezés esetére
    private string errorMessage;


    // A bejelentkezési folyamat kezelése:
    // elküldi az adatokat az API-nak, majd siker esetén elmenti a felhasználói adatokat localStorage-ba
    private async Task HandleLogin()
    {
        errorMessage = null;
        var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);

        if (response.IsSuccessStatusCode)
        {
            // Kiolvassuk a választ a UserDto-ba
            var result = await response.Content.ReadFromJsonAsync<UserDto>();
            

            if (result != null)
            {
                await localStorage.SetItemAsync("token", result.Token);
                await localStorage.SetItemAsync("userName", result.Username);
                await localStorage.SetItemAsync("isAuthenticated", true);
                await localStorage.SetItemAsync("userId", result.Id);

                //Az adatbázisból jövő Role szöveget ("Admin" vagy "User") mentjük el!
                await localStorage.SetItemAsync("userRole", result.Role);

                // Sikeres bejelentkezés után visszairányítás a főoldalra
                NavManager.NavigateTo("/", forceLoad: true);
            }
        }
        else
        {   // Hibás belépési adatok esetén visszajelzés a felhasználónak
            errorMessage = "Hibás email vagy jelszó!";
        }
    }
}