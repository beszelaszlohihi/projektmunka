@page "/login"
@using F1ZoneLibrary.Dto
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="f1-body login-page">
    <div class="login-card">
        <div class="login-header">
            <a href="/" class="logo">F1<span>ZONE</span></a>
            <h2>Bejelentkezés</h2>
            <p>Lépj be a profilodba a teljes élményért!</p>
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <div class="form-group">
                <label>Email cím</label>
                <input type="email" @bind-value="loginModel.Email" placeholder="pelda@email.com" required />
            </div>

            <div class="form-group">
                <label>Jelszó</label>
                <input type="password" @bind-value="loginModel.Password" placeholder="••••••••" required />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-msg">@errorMessage</div>
            }

            <button type="submit" class="hero-btn">BEJELENTKEZÉS</button>
        </EditForm>

        <div class="login-footer">
            <p>Nincs még fiókod? <a href="/register">Regisztráció</a></p>
        </div>
    </div>
</div>

@code {
    private LoginDto loginModel = new LoginDto();
    private string errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;
        var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);

        if (response.IsSuccessStatusCode)
        {
            // Sikeres belépés után irány a főoldal
            var user = await response.Content.ReadFromJsonAsync<UserDto>(); // Feltételezve, hogy az API visszaküldi a user adatait
            await localStorage.SetItemAsync("userName", user.Username);
            await localStorage.SetItemAsync("userRole", user.Role);
            await localStorage.SetItemAsync("isAuthenticated", true);
            NavManager.NavigateTo("/", forceLoad: true); // forceLoad: true, hogy a fejléc frissüljön
        }
        else
        {
            errorMessage = "Hibás email vagy jelszó! Próbáld újra.";
        }
    }
}