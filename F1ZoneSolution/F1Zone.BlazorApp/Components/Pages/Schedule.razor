@page "/schedule"
@using F1ZoneLibrary.Dto
@inject HttpClient Http
@inject NavigationManager NavManager
@rendermode InteractiveServer
@inject Blazored.LocalStorage.ILocalStorageService localStorage

@* Felső navigációs sáv, amely a felhasználó bejelentkezési állapota
   és szerepköre alapján jelenít meg különböző menüpontokat *@
<nav class="navbar">
    <div class="nav-container">
        <div class="nav-brand">
            <a href="/" class="logo">F1<span>ZONE</span></a>
        </div>

        <ul class="nav-links @(isMenuOpen ? "active" : "")">
            <li><a href="/" @onclick="CloseMenu">Kezdőlap</a></li>
            <li><a href="/tracks" @onclick="CloseMenu">Pályák</a></li>
            <li><a href="/drivers" @onclick="CloseMenu">Versenyzők</a></li>
            <li><a href="/schedule" @onclick="CloseMenu">Versenynaptár</a></li>
            <li><a href="/News" @onclick="CloseMenu">Hírek</a></li>
            <li><a href="/regulation_changes" @onclick="CloseMenu">Szabályok</a></li>
            <li><a href="/strategy">Stratégia</a></li>

            @* Admin felhasználók számára külön menüpont megjelenítése *@
            @if (isLoggedIn && userRole == "Admin")
            {
                <li><a href="/admin" @onclick="CloseMenu">Adatok szerkesztése</a></li>
            }

            @* Mobilnézetben a felhasználói műveletek külön blokkban jelennek meg *@
            <li class="mobile-only">
                @if (isLoggedIn)
                {
                    <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                    <button class="login-btn" @onclick="Logout">KIJELENTKEZÉS</button>
                }
                else
                {
                    <button class="login-btn" @onclick="GoToLogin">BEJELENTKEZÉS</button>
                }
            </li>
        </ul>

        <div class="nav-actions">
            @if (isLoggedIn)
            {

                @if (userRole == "Admin")
                {
                    <button class="login-btn desktop-only" @onclick='() => NavManager.NavigateTo("/admin/home")'>ADMIN</button>
                }
                <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                <button class="login-btn desktop-only" @onclick="Logout">KIJELENTKEZÉS</button>
            }
            else
            {
                <button class="login-btn desktop-only" @onclick="GoToLogin">BEJELENTKEZÉS</button>
            }

            @* Hamburger menü mobil eszközökhöz *@
            <button class="burger-btn" @onclick="ToggleMenu">
                @if (isMenuOpen)
                {
                    <span>&times;</span>
                }
                else
                {
                    <span>&#9776;</span>
                }
            </button>
        </div>
    </div>
</nav>

<div class="schedule-container">
    @* A teljes versenynaptár listázása kártyás formában *@
    @foreach (var race in races)
    {
        
        <div class="race-card @(race.RaceDate < DateTime.Now ? "past-race" : "")">
            <div class="round-number">ROUND @(races.IndexOf(race) + 1)</div>
            <div class="card-left">
                <img src="https://flagcdn.com/w80/@(race.CountryCode?.ToLower() ?? "un").png" alt="Flag" class="flag" />
                <div class="race-info">
                    <span class="race-date">@race.RaceDate.ToString("MMM dd").ToUpper()</span>
                    <h3 class="race-name">@race.RaceName</h3>
                    <span class="track-name">@race.TrackName</span>
                </div>
            </div>

            <div class="card-right">
                @if (race.RaceDate < DateTime.Now)
                {
                    <button class="status-badge finished clickable" @onclick="() => Eredmenyek(race.Id)" style="cursor: pointer;">LEZAJLOTT</button>
                }
                else
                {
                    <button class="details-btn" @onclick="() => NavigateToDetails(race.Id)">Részletek <i class="f1-icon-arrow"></i></button>
                }
            </div>
        </div>
    }
</div>

@code {
    // A versenynaptár futamainak listája
    private List<RaceDto> races = new();

    // A navigációs menü állapotának kezelése
    private bool isMenuOpen = false;

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    // A felhasználó bejelentkezési állapotának és adatainak tárolása
    private bool isLoggedIn = false;
    private string userName = "";
    private string userRole = "";

    // Navigáció a bejelentkezési oldalra
    private void GoToLogin() => NavManager.NavigateTo("/login");

    // Az oldal inicializálásakor lekérjük a versenynaptár adatait az API-ból
    protected override async Task OnInitializedAsync()
    {
        races = await Http.GetFromJsonAsync<List<RaceDto>>("api/raceschedules");
    }

    private void Eredmenyek(int raceId)
    {
        NavManager.NavigateTo($"/eredmenyek/{raceId}");
    }

    // Az első renderelés után kiolvassuk a local storage-ból
    // a bejelentkezési állapotot és a felhasználói adatokat
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            
            isLoggedIn = await localStorage.GetItemAsync<bool>("isAuthenticated");

            if (isLoggedIn)
            {
                
                userName = await localStorage.GetItemAsync<string>("userName") ?? "Felhasználó";
                userRole = await localStorage.GetItemAsync<string>("userRole") ?? "User";
            }

            StateHasChanged();

        }
    }
    

    // Navigáció a kiválasztott futam részletező oldalára
    private void NavigateToDetails(int raceId)
    {
        NavManager.NavigateTo($"/schedule/details/{raceId}");
    }

    // Kijelentkezéskor töröljük a helyi tárolt adatokat,
    // majd visszairányítjuk a felhasználót a főoldalra
    private async Task Logout()
    {
        await localStorage.ClearAsync();
        isLoggedIn = false;
        userName = "";
        userRole = "";
        NavManager.NavigateTo("/", forceLoad: true);
    }
  

    public class RaceDto
    {
        public int Id { get; set; }
        public string RaceName { get; set; } = "";
        public string TrackName { get; set; } = "";
        public DateTime RaceDate { get; set; }
        public string CountryCode { get; set; } = "";
    }
}
