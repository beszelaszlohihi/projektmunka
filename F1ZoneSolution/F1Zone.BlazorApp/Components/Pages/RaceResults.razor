@page "/eredmenyek/{RaceId:int}"
@inject HttpClient Http
@using F1ZoneLibrary.MODEL
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="race-result-container">
    <div class="result-card">
        <div class="card-header">
            <h3>@FutamNeve EREDMÉNYEK</h3>
            <div class="f1-line"></div>
        </div>



        @if (Eredmeny == null)
        {
            <div class="loading-spinner">Töltés...</div>
        }
        else
        {
            <div class="podium-section">
                <div class="podium-row first-place">
                    <div class="position-badge gold">1</div>
                    <div class="driver-info">
                        <span class="driver-name">@(Gyoztes != null ? Gyoztes.driver_name : "Töltés...")</span>
                    </div>
                </div>

                <div class="podium-row">
                    <div class="position-badge silver">2</div>
                    <div class="driver-info">
                        <span class="driver-name">@(Masodik != null ? Masodik.driver_name : "Nincs adat")</span>
                    </div>
                </div>

                <div class="podium-row">
                    <div class="position-badge bronze">3</div>
                    <div class="driver-info">
                        <span class="driver-name">@(Harmadik != null ? Harmadik.driver_name : "Nincs adat")</span>
                    </div>
                </div>
            </div>

            <div class="stats-section">
                <div class="stat-box">
                    <span class="stat-label">LEGGYORSABB KÖR</span>
                    <span class="stat-value highlight">@Eredmeny.fastest_lap_time.ToString(@"mm\:ss\.fff")</span>
                    <span class="stat-driver">@(Leggyorsabb != null ? Leggyorsabb.driver_name : "Nincs adat")</span>
                </div>

                <div class="stat-box">
                    <span class="stat-label">TELJES VERSENYIDŐ</span>
                    <span class="stat-value">@Eredmeny.race_time.ToString(@"hh\:mm\:ss\.fff")</span>
                    <span class="stat-driver">Hivatalos időeredmény</span>
                </div>
            </div>

            <button class="back-btn" @onclick='() => NavManager.NavigateTo("/schedule")'>
                <span>&larr;</span> Vissza a versenynaptárhoz
            </button>
        }
    </div>
</div>

@code {
    [Parameter]
    public int RaceId { get; set; }

    private Races Eredmeny;

    // Ide mentjük el a letöltött pilótákat
    private F1ZoneLibrary.MODEL.Drivers Gyoztes;
    private F1ZoneLibrary.MODEL.Drivers Masodik;
    private F1ZoneLibrary.MODEL.Drivers Harmadik;
    private F1ZoneLibrary.MODEL.Drivers Leggyorsabb;
    private F1ZoneLibrary.MODEL.Drivers Gyorspilota;
    private string FutamNeve = "FUTAM";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Letöltjük a futamot
            Eredmeny = await Http.GetFromJsonAsync<Races>($"api/pastraces/{RaceId}");

            if (Eredmeny != null)
            {
                // Letöltjük a győztest az ID alapján
                Gyoztes = await Http.GetFromJsonAsync<F1ZoneLibrary.MODEL.Drivers>($"api/drivers/{Eredmeny.winner_driver_id}");

                // 2. helyezett lekérése (Csak akkor, ha ki van töltve az adatbázisban)
                if (Eredmeny.second_place_driver_id != null)
                {
                    Masodik = await Http.GetFromJsonAsync<F1ZoneLibrary.MODEL.Drivers>($"api/drivers/{Eredmeny.second_place_driver_id}");
                }

                // 3. helyezett lekérése
                if (Eredmeny.third_place_driver_id != null)
                {
                    Harmadik = await Http.GetFromJsonAsync<F1ZoneLibrary.MODEL.Drivers>($"api/drivers/{Eredmeny.third_place_driver_id}");
                }

                var futamAdat = await Http.GetFromJsonAsync<RaceSchedules>($"api/raceschedules/{RaceId}");
                if (futamAdat != null)
                {
                    FutamNeve = futamAdat.RaceName.ToUpper();
                }

                //Letöltjük a leggyorsabb körös pilótát az ID alapján
                Leggyorsabb = await Http.GetFromJsonAsync<F1ZoneLibrary.MODEL.Drivers>($"api/drivers/{Eredmeny.fastest_lap_driver_id}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Hiba: " + ex.Message);
        }
    }
}