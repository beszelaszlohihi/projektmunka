@page "/news"
@using System.Net.Http.Json
@inject HttpClient Http
@rendermode InteractiveServer
@using System.Text.Json.Serialization
@inject NavigationManager Nav

<div class="news-page">
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <a href="/" class="logo">F1<span>ZONE</span></a>
            </div>

            <ul class="nav-links @(isMenuOpen ? "active" : "")">
                <li><a href="/" @onclick="CloseMenu">Kezdőlap</a></li>
                <li><a href="/tracks" @onclick="CloseMenu">Pályák</a></li>
                <li><a href="/drivers" @onclick="CloseMenu">Versenyzők</a></li>
                <li><a href="/schedule" @onclick="CloseMenu">Versenynaptár</a></li>
                <li><a href="/News" @onclick="CloseMenu">Hírek</a></li>
                <li><a href="/regulation_changes" @onclick="CloseMenu">Szabályok</a></li>


                <li class="mobile-only">
                    <button class="login-btn">BEJELENTKEZÉS</button>
                </li>
            </ul>


            <div class="nav-actions">
                <button class="login-btn desktop-only">BEJELENTKEZÉS</button>

                <button class="burger-btn" @onclick="ToggleMenu">
                    @if (isMenuOpen)
                    {
                        <span>&times;</span>
                    }
                    else
                    {

                        <span>&#9776;</span>
                    }
                </button>
            </div>
        </div>
    </nav>
    <header class="news-header">
        <h1>Legfrissebb Hírek</h1>
        <p>Hivatalos F1 hírek magyar nyelven</p>
    </header>

    <div class="container">
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div style="color:red; background:white; padding:10px;">@errorMsg</div>
        }

        @if (articles == null)
        {
            <p>Betöltés...</p>
        }
        else if (articles.Count == 0)
        {
            <p>A lista üres, nem találtunk híreket.</p>
        }
        else
        {
            <div class="news-grid">
                @foreach (var article in articles)
                {
                    <div class="news-card" @onclick="@(() => OpenArticle(article.Url))">
                        @if (!string.IsNullOrEmpty(article.UrlToImage))
                        {
                            <div class="card-image">
                                <img src="@article.UrlToImage" alt="news" />
                            </div>
                        }
                        <div class="card-content">
                            <span class="source-tag">@article.Source?.Name</span>
                            <h3>@article.Title</h3>
                            <p>@article.Description</p>
                            <div class="card-footer">
                                <span>@article.PublishedAt.ToString("yyyy.MM.dd. HH:mm")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<NewsArticle>? articles;
    private string? errorMsg;

    // IDE MÁSOLD BE A SAJÁT KULCSODAT A NEWSAPI.ORG-RÓL
    private string apiKey = "a1184626f3ff4c4e9cfefdd5ca821261";

    private bool isMenuOpen = false;

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    // ...
    private void OpenArticle(string url)
    {
        Nav.NavigateTo(url);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            errorMsg = null;
            // Egyszerűbb URL, szóközök nélkül
            var url = $"https://newsapi.org/v2/everything?q=F1&language=hu&sortBy=publishedAt&apiKey={apiKey}";

            // Használjunk egy biztonságosabb lekérést fejléc hozzáadásával
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("User-Agent", "BlazorApp");

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NewsResponse>();
                if (result != null && result.Articles != null)
                {
                    articles = result.Articles.Where(a => a.Title != "[Removed]").ToList();
                }
            }
            else
            {
                errorMsg = $"API Hiba: {response.StatusCode} - {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMsg = $"Kritikus hiba: {ex.Message}";
            articles = new List<NewsArticle>();
        }
    }

    // --- DTO OSZTÁLYOK (Csak egyszer szerepeljenek!) ---

    public class NewsResponse
    {
        [JsonPropertyName("status")]
        public string Status { get; set; } = "";

        [JsonPropertyName("articles")]
        public List<NewsArticle> Articles { get; set; } = new();
    }

    public class NewsArticle
    {
        [JsonPropertyName("source")]
        public Source? Source { get; set; }

        [JsonPropertyName("title")]
        public string Title { get; set; } = "";

        [JsonPropertyName("description")]
        public string Description { get; set; } = "";

        [JsonPropertyName("url")]
        public string Url { get; set; } = "";

        [JsonPropertyName("urlToImage")]
        public string UrlToImage { get; set; } = "";

        [JsonPropertyName("publishedAt")]
        public DateTime PublishedAt { get; set; }
    }

    public class Source
    {
        [JsonPropertyName("name")]
        public string Name { get; set; } = "";
    }
}