@page "/news"
@using System.Net.Http.Json
@inject HttpClient Http
@rendermode InteractiveServer
@using System.Text.Json.Serialization
@using F1ZoneLibrary.MODEL
@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="news-page">
    @* Felső navigációs sáv, amely a felhasználó bejelentkezési állapota
       és szerepköre alapján jelenít meg különböző menüpontokat *@
   

    <header class="news-header">
        <h1>Legfrissebb Hírek</h1>
        <p>Hivatalos F1 hírek magyar nyelven</p>

        
        @* Bejelentkezett felhasználó esetén, ha vannak kedvenc pilóták,
           megjelenítjük a kedvencek szerinti szűrő kapcsolót *@
        @if (isLoggedIn && favoriteDriverNames.Any())
        {
            <div class="filter-container mt-3">
                <button class="filter-toggle-btn @(showOnlyFavorites ? "active" : "")" @onclick="() => showOnlyFavorites = !showOnlyFavorites">
                    <i class="fas fa-heart"></i> @(showOnlyFavorites ? "Minden hír mutatása" : "Csak a kedvenceim hírei")
                </button>
            </div>
        }
    </header>

    <div class="container">
        @* Hiba esetén visszajelző üzenet megjelenítése *@
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="alert alert-danger">@errorMsg</div>
        }

        @* Betöltés közben tájékoztató szöveg jelenik meg *@
        @if (articles == null)
        {
            <div class="loader-container">
                <p>Hírek keresése a pályán...</p>
            </div>
        }

        @* Ha nincs megjeleníthető hír, külön üres állapotot mutatunk *@
        else if (DisplayedArticles.Count == 0)
        {
            <div class="empty-news">
                <p>@(showOnlyFavorites ? "Egyik kedvenc pilótádról sem találtunk friss hírt." : "A lista üres, nem találtunk híreket.")</p>
            </div>
        }
        else
        {
            @* A szűrés utáni hírek listájának kártyás megjelenítése *@
            <div class="news-grid">
                @foreach (var article in DisplayedArticles)
                {
                    bool isFavArticle = favoriteDriverNames.Any(name =>
                    (article.Title?.Contains(name, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (article.Description?.Contains(name, StringComparison.OrdinalIgnoreCase) ?? false));

                    <div class="news-card @(isFavArticle ? "favorite-highlight" : "")" @onclick="@(() => OpenArticle(article.Url))">
                        @if (!string.IsNullOrEmpty(article.UrlToImage))
                        {
                            <div class="card-image">
                                <img src="@article.UrlToImage" alt="news" />
                                @if (isFavArticle)
                                {
                                    <span class="fav-badge">KEDVENC</span>
                                }
                            </div>
                        }
                        <div class="card-content">
                            <span class="source-tag">@article.Source?.Name</span>
                            <h3>@article.Title</h3>
                            <p>@article.Description</p>
                            <div class="card-footer">
                                <span>@article.PublishedAt.ToString("yyyy.MM.dd. HH:mm")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {

    // A lekért hírek és az esetleges hibaüzenet tárolása
    private List<NewsArticle>? articles;
    private string? errorMsg;

    // A hírszolgáltató API kulcsa
    private string apiKey = "a1184626f3ff4c4e9cfefdd5ca821261";

    // A navigációs menü, bejelentkezési állapot és felhasználói adatok kezelése
    
    private bool isLoggedIn = false;
    
    private List<string> favoriteDriverNames = new();
    private int currentUserId;
    private bool showOnlyFavorites = false;


    // A megjelenítendő hírek listája:
    // ha nincs szűrés, minden hír látszik;
    // ha a szűrő aktív, csak a kedvenc pilótákhoz kapcsolódó hírek jelennek meg
    private List<NewsArticle> DisplayedArticles
    {
        get
        {
            
            if (articles == null) return new List<NewsArticle>();

            
            if (!showOnlyFavorites) return articles;

            
            return articles.Where(a =>
            {
                
                foreach (var fullName in favoriteDriverNames)
                {
                    if (string.IsNullOrWhiteSpace(fullName)) continue;

                    // Szétvágjuk a nevet részekre (pl. "Fernando Alonso" -> ["Fernando", "Alonso"])
                    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                    foreach (var part in nameParts)
                    {
                        // Csak a 3 betűnél hosszabb névrészleteket keressük (hogy a "le" meg hasonlók ne zavarjanak be)
                        if (part.Length < 3) continue;

                        // Ellenőrizzük a címet és a leírást
                        bool inTitle = a.Title != null && a.Title.Contains(part, StringComparison.OrdinalIgnoreCase);
                        bool inDesc = a.Description != null && a.Description.Contains(part, StringComparison.OrdinalIgnoreCase);

                        if (inTitle || inDesc)
                        {
                            return true; // Találtunk egyezést a név valamelyik részével!
                        }
                    }
                }
                return false; // Egyik névrészlet sem szerepelt ebben a hírben
            }).ToList();
        }
    }


    // A kiválasztott hír megnyitása
    private async Task OpenArticle(string url)
    {
        Nav.NavigateTo(url);
    }

    
    // Az oldal inicializálásakor betöltjük a híreket az API-ból
    protected override async Task OnInitializedAsync()
    {
        await FetchNews();
    }

    // Hírek lekérése külső API-ból, majd a használható elemek eltárolása
    private async Task FetchNews()
    {
        try
        {
            errorMsg = null;
            var url = $"https://newsapi.org/v2/everything?q=F1&language=hu&sortBy=publishedAt&apiKey={apiKey}";
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("User-Agent", "BlazorApp");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NewsResponse>();
                if (result != null && result.Articles != null)
                {
                    articles = result.Articles.Where(a => a.Title != "[Removed]").ToList();
                }
            }
        }
        catch (Exception ex) { errorMsg = $"Hiba: {ex.Message}"; }
    }


    // Az első renderelés után betöltjük a local storage-ból
    // a felhasználói adatokat, majd lekérjük a kedvenc pilóták neveit
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoggedIn = await localStorage.GetItemAsync<bool>("isAuthenticated");
            if (isLoggedIn)
            {
                currentUserId = await localStorage.GetItemAsync<int>("userId");
                
                await LoadFavoriteNames();
            }
            StateHasChanged();
        }
    }

    // A felhasználó kedvenc pilótáinak neveit lekérjük,
    // hogy ezek alapján tudjuk szűrni és kiemelni a híreket
    private async Task LoadFavoriteNames()
    {
        try
        {
            // Lekérjük a kedvencek rekordjait
            var favs = await Http.GetFromJsonAsync<List<UserFavorites>>("api/favorites");
            var favIds = favs.Where(f => f.UserId == currentUserId && f.ItemType == "Driver").Select(f => f.ItemId).ToList();

            // Lekérjük az összes pilótát
            var allDrivers = await Http.GetFromJsonAsync<List<F1ZoneLibrary.MODEL.Drivers>>("api/drivers");

            // Kiválogatjuk a kedvenc pilóták neveit az ID-k alapján
            favoriteDriverNames = allDrivers
                .Where(d => favIds.Contains(d.driver_id))
                .Select(d => d.driver_name) 
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Hiba a nevek betöltésekor");
        }


        Console.WriteLine($"Kedvenc nevek száma: {favoriteDriverNames.Count}");
        foreach (var n in favoriteDriverNames) Console.WriteLine($"Név a listában: {n}");
    }

    

    // --- DTO OSZTÁLYOK

    public class NewsResponse
    {
        [JsonPropertyName("status")]
        public string Status { get; set; } = "";

        [JsonPropertyName("articles")]
        public List<NewsArticle> Articles { get; set; } = new();
    }

    public class NewsArticle
    {
        [JsonPropertyName("source")]
        public Source? Source { get; set; }

        [JsonPropertyName("title")]
        public string Title { get; set; } = "";

        [JsonPropertyName("description")]
        public string Description { get; set; } = "";

        [JsonPropertyName("url")]
        public string Url { get; set; } = "";

        [JsonPropertyName("urlToImage")]
        public string UrlToImage { get; set; } = "";

        [JsonPropertyName("publishedAt")]
        public DateTime PublishedAt { get; set; }
    }

    public class Source
    {
        [JsonPropertyName("name")]
        public string Name { get; set; } = "";
    }
}