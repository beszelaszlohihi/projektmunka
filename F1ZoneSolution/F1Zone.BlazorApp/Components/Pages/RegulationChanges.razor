@page "/regulation_changes"
@using F1ZoneLibrary.Dto
@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http

<div class="f1-body">
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <a href="/" class="logo">F1<span>ZONE</span></a>
            </div>

            <ul class="nav-links @(isMenuOpen ? "active" : "")">
                <li><a href="/" @onclick="CloseMenu">Kezdőlap</a></li>
                <li><a href="/tracks" @onclick="CloseMenu">Pályák</a></li>
                <li><a href="/drivers" @onclick="CloseMenu">Versenyzők</a></li>
                <li><a href="/schedule" @onclick="CloseMenu">Versenynaptár</a></li>
                <li><a href="/News" @onclick="CloseMenu">Hírek</a></li>
                <li><a href="/regulation_changes" @onclick="CloseMenu">Szabályok</a></li>


                <li class="mobile-only">
                    <button class="login-btn">BEJELENTKEZÉS</button>
                </li>
            </ul>


            <div class="nav-actions">
                <button class="login-btn desktop-only">BEJELENTKEZÉS</button>

                <button class="burger-btn" @onclick="ToggleMenu">
                    @if (isMenuOpen)
                    {
                        <span>&times;</span>
                    }
                    else
                    {

                        <span>&#9776;</span>
                    }
                </button>
            </div>
        </div>
    </nav>
    <div class="timeline-container">
        <div class="section-header">
            <h2>Technikai Szabályváltozások</h2>
            <p>Az oldalon az első hivatalos szezontól a mai napig a nagyobb, jelentőségteljesebb szabályváltozásokat gyűjtöttük össze ide.</p>
        </div>

        @if (regulations == null)
        {
            <p class="loading">Adatok betöltése a boxutcából...</p>
        }
        else
        {
            <div class="timeline">
                @foreach (var reg in regulations)
                {
                    <div class="timeline-item">
                        <div class="timeline-year">@reg.Season_year</div>
                        <div class="timeline-content">
                            <p>@reg.Technical_regulations</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    // Ide jön majd a C# kód az adatbázis híváshoz
    private List<RegulationDto> regulations; // Feltételezve, hogy van ilyen DTO-d

    private bool isMenuOpen = false;

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // IDE ÍRD AZ API-D PONTOS NEVÉT!
            // Ha a kontrollered neve pl. TechnicalRegulationsController, akkor "api/TechnicalRegulations"
            regulations = await Http.GetFromJsonAsync<List<RegulationDto>>("api/Seasons");
        }
        catch (Exception ex)
        {
            // Ha hiba van, itt látszódni fog a konzolon (F12 a böngészőben)
            Console.WriteLine($"Hiba történt: {ex.Message}");
        }
    }
}