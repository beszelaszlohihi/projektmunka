@page "/regulation_changes"
@using F1ZoneLibrary.Dto
@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="f1-body">
  
    <div class="timeline-container">
        <div class="section-header">
            <h2>Technikai Szabályváltozások</h2>
            <p>Az oldalon az első hivatalos szezontól a mai napig a nagyobb, jelentőségteljesebb szabályváltozásokat gyűjtöttük össze ide.</p>
        </div>

        @* Betöltés közben tájékoztató szöveg jelenik meg *@
        @if (regulations == null)
        {
            <p class="loading">Adatok betöltése a boxutcából...</p>
        }
        else
        {
            @* A szabályváltozások idővonalas megjelenítése évszám szerint *@
            <div class="timeline">
                @foreach (var reg in regulations)
                {
                    <div class="timeline-item">
                        <div class="timeline-year">@reg.reg_change_year</div>
                        <div class="timeline-content">
                            <p>@reg.Technical_regulations</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    // A lekért szabályváltozások listája
    private List<RegulationDto> regulations; 

    // A navigációs menü és a felhasználói állapot kezeléséhez szükséges változók
   

    

    // Az oldal inicializálásakor lekérjük a szabályváltozások adatait az API-ból
    protected override async Task OnInitializedAsync()
    {
        try
        {
            regulations = await Http.GetFromJsonAsync<List<RegulationDto>>("api/Seasons");
        }
        catch (Exception ex)
        {
            //Hiba üzenet a felhasználónak
            Console.WriteLine($"Hiba történt: {ex.Message}");
        }
    }
}