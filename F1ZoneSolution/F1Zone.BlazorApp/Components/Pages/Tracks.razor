@page "/tracks"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="f1-body">
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <a href="/" class="logo">F1<span>ZONE</span></a>
            </div>

            <ul class="nav-links @(isMenuOpen ? "active" : "")">
                <li><a href="/" @onclick="CloseMenu">Kezdőlap</a></li>
                <li><a href="/tracks" @onclick="CloseMenu">Pályák</a></li>
                <li><a href="/drivers" @onclick="CloseMenu">Versenyzők</a></li>
                <li><a href="/schedule" @onclick="CloseMenu">Versenynaptár</a></li>
                <li><a href="/News" @onclick="CloseMenu">Hírek</a></li>
                <li><a href="/regulation_changes" @onclick="CloseMenu">Szabályok</a></li>

                @if (isLoggedIn && userRole == "Admin")
                {
                    <li><a href="/admin" @onclick="CloseMenu">Adatok szerkesztése</a></li>
                }

                <li class="mobile-only">
                    @if (isLoggedIn)
                    {
                        <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                        <button class="login-btn" @onclick="Logout">KIJELENTKEZÉS</button>
                    }
                    else
                    {
                        <button class="login-btn" @onclick="GoToLogin">BEJELENTKEZÉS</button>
                    }
                </li>
            </ul>

            <div class="nav-actions">
                @if (isLoggedIn)
                {

                    @if (userRole == "Admin")
                    {
                        <button class="login-btn desktop-only" @onclick='() => NavManager.NavigateTo("/admin/home")'>ADMIN</button>
                    }
                    <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                    <button class="login-btn desktop-only" @onclick="Logout">KIJELENTKEZÉS</button>
                }
                else
                {
                    <button class="login-btn desktop-only" @onclick="GoToLogin">BEJELENTKEZÉS</button>
                }

                <button class="burger-btn" @onclick="ToggleMenu">
                    @if (isMenuOpen)
                    {
                        <span>&times;</span>
                    }
                    else
                    {
                        <span>&#9776;</span>
                    }
                </button>
            </div>
        </div>
    </nav>
    <div class="section-header" style="margin-top: 4rem; text-align: center;">
        <h2>Versenynaptár Pályái</h2>
        <p>Böngészd végig a Forma-1 szezon összes legendás helyszínét!</p>
    </div>

    @if (tracks == null)
    {
        <p style="text-align: center;"><em>Pályák betöltése a boxutcából...</em></p>
    }
    else
    {
        <div class="tracks-grid">
            @foreach (var track in tracks)
            {
                <article class="track-card">
                    <div class="track-image">
                        <img src="@(string.IsNullOrEmpty(track.ImageUrl) ? "https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?w=600&h=400&fit=crop" : track.ImageUrl)" alt="@track.Circuit_name">
                    </div>
                    <div class="track-content">
                        <div class="track-country">@track.Country</div>
                        <h3 class="track-name">@track.Circuit_name</h3>
                        <p>@track.Circuit_description</p>
                        <div class="track-stats">
                            <div class="stat"><div class="stat-value">@track.Length_km km</div><div class="stat-label">Hossz</div></div>
                            <div class="stat"><div class="stat-value">@track.Turns</div><div class="stat-label">Kanyar</div></div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<Track>? tracks;

    private bool isLoggedIn = false;
    private string userName = "";
    private string userRole = "";
    private bool isMenuOpen = false;

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;
    private void GoToLogin() => NavManager.NavigateTo("/login");

    private async Task Logout()
    {
        await localStorage.ClearAsync();
        isLoggedIn = false;
        userName = "";
        userRole = "";
        NavManager.NavigateTo("/", forceLoad: true);
    }

    protected override async Task OnInitializedAsync()
    {

        tracks = await Http.GetFromJsonAsync<List<Track>>("api/Circuits");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Kiolvassuk, hogy be van-e jelentkezve
            isLoggedIn = await localStorage.GetItemAsync<bool>("isAuthenticated");

            if (isLoggedIn)
            {
                // Ha igen, beletesszük a dobozokba a nevet és a rangot
                userName = await localStorage.GetItemAsync<string>("userName") ?? "Felhasználó";
                userRole = await localStorage.GetItemAsync<string>("userRole") ?? "User";
            }

            // Megkérjük a Blazort, hogy rajzolja újra az oldalt a friss adatokkal
            StateHasChanged();
        }
    }


    // Az adatmodell a pályákhoz
    public class Track
    {
        public int Id { get; set; }
        public string Circuit_name { get; set; }
        public string Location { get; set; }
        public string Country { get; set; }
        public double Length_km { get; set; }
        public int Turns { get; set; }
        public string? ImageUrl { get; set; }
        public string Circuit_description { get; set; }
    }
}