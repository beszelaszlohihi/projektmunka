@page "/admin/edit-driver/{Id:int}"
@using F1ZoneLibrary.Dto
@inject HttpClient Http
@inject NavigationManager NavManager

<div class="f1-body login-page">
    <div class="login-card admin-card">
        <h3>@driver.driver_name szerkesztése</h3>
        
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <p class="status-msg @statusClass">@statusMessage</p>
        }

        <EditForm Model="@driver" OnValidSubmit="UpdateDriver">
            <div class="form-group">
                <label>Győzelmek száma</label>
                <input type="number" @bind-value="driver.wins" />
            </div>

            <div class="form-group">
                <label>VB címek</label>
                <input type="number" @bind-value="driver.championships" />
            </div>

            <div class="form-group">
                <label>Pontszám</label>
                <input type="number" step="0.5" @bind-value="driver.points" />
            </div>
            <div class="form-group">
                <label>Nemzetiség</label>
                <input type="text" @bind-value="driver.nationality" />
            </div>

            <div class="form-group">
                <label>Bemutatkozás éve</label>
                <input type="number" @bind-value="driver.debut_year" />
            </div>

            <div class="form-group">
                <label>Dobogók</label>
                <input type="number" @bind-value="driver.podiums" />
            </div>

            <div class="form-group">
                <label>Leggyorsabb körök</label>
                <input type="number" @bind-value="driver.fastest_laps" />
            </div>

            <div class="form-group">
                <label>Életrajz</label>
                <textarea @bind="driver.biography" rows="3" class="form-control"></textarea>
            </div>

            <button type="submit" class="hero-btn">ADATOK FRISSÍTÉSE</button>
            <button type="button" class="logout-btn" @onclick='() => NavManager.NavigateTo("/admin")'>MÉGSE</button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private DriverDto driver = new DriverDto();
    private string statusMessage = "";
    private string statusClass = "";

    protected override async Task OnInitializedAsync()
    {
        // Betöltjük a pilótát szerkesztésre
        var allDrivers = await Http.GetFromJsonAsync<List<DriverDto>>("api/drivers/admin-list");
        driver = allDrivers.FirstOrDefault(d => d.driver_id == Id);
    }

    private async Task UpdateDriver()
    {
        statusMessage = "Mentés folyamatban...";

        // Elküldjük a módosított adatokat az API-nak
        var response = await Http.PutAsJsonAsync($"api/drivers/{Id}", driver);

        if (response.IsSuccessStatusCode)
        {
            statusMessage = "✅ Sikerült elmenteni!";
            StateHasChanged();
            await Task.Delay(1500);
            NavManager.NavigateTo("/admin");
        }
        else
        {
            statusMessage = "❌ Hiba történt! (API hiba)";
        }
    }
}