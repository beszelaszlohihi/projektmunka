@code {
    private bool isMenuOpen = false;

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    private IEnumerable<IGrouping<string, DriverDto>> groupedDrivers;
    private List<F1ZoneLibrary.Dto.DriverDto> drivers;

    protected override async Task OnInitializedAsync()
    {
        // Az admin-list-et hívjuk, mert abban benne van a teamname és a bio is
        var allDrivers = await Http.GetFromJsonAsync<List<DriverDto>>("api/drivers/admin-list");
        if (allDrivers != null)
        {
            // Csoportosítás csapat szerint
            groupedDrivers = allDrivers.Where(d => d.teamname != null).GroupBy(d => d.teamname);
        }
    }

    // Ez a függvény a #HEX színből csinál rgba(r,g,b, 0.15) formátumot
    private string HexToRgba(string hex, double opacity)
    {
        if (string.IsNullOrEmpty(hex)) return $"rgba(255,255,255,{opacity})";
        try
        {
            var r = int.Parse(hex.Substring(1, 2), System.Globalization.NumberStyles.HexNumber);
            var g = int.Parse(hex.Substring(3, 2), System.Globalization.NumberStyles.HexNumber);
            var b = int.Parse(hex.Substring(5, 2), System.Globalization.NumberStyles.HexNumber);
            return $"rgba({r}, {g}, {b}, {opacity.ToString().Replace(",", ".")})";
        }
        catch
        {
            return $"rgba(255,255,255,{opacity})";
        }
    }
}