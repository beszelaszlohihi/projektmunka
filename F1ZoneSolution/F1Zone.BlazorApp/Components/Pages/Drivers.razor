@page "/drivers"
@using F1ZoneLibrary.MODEL
@inject NavigationManager NavManager
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager NavManager

<div class="drivers-body">
    @* Az oldal címe és rövid leírása *@
    <section class="hero">
        <h1>Piloták</h1>
        <p>Kattints egy pilotára, hogy többet tudj meg róla</p>
    </section>

    <div class="container">

        @* Amíg a pilóták nem töltődnek be, betöltési szöveget jelenítünk meg *@
        @if (groupedDrivers == null)
        {
            <p>Adatok betöltése...</p>
        }
        else
        {
            @* A pilótákat csapatok szerint csoportosítva jelenítjük meg *@
            @foreach (var group in groupedDrivers)
            {
                <div class="team-section">
                    <div class="team-header">
                        @* 1. A csapat függőleges csíkja *@
                        <div class="team-color-bar" style="background: @(group.FirstOrDefault()?.teamcolor ?? "#3671C6")"></div>
                        <h2>@group.Key</h2>
                    </div>

                    <div class="drivers-grid">
                        @foreach (var driver in group)
                        {
                           
                            <div class="driver-card-wrapper" style="position: relative;">

                                @* Maga a kattintható kártya *@
                                <a class="driver-card" href="/driver/@driver.driver_name.Replace(" ", "-").ToLower()" style="display: block;">
                                    <span class="driver-number-bg" style="color: @driver.teamcolor; opacity: 0.2;">
                                        @(driver.racing_number ?? 0)
                                    </span>

                                    <div class="driver-avatar" style="background: @(HexToRgba(driver.teamcolor, 0.1)); border: 1px solid @driver.teamcolor; box-shadow: 0 0 10px @(HexToRgba(driver.teamcolor, 0.3)); color: @driver.teamcolor;">
                                        @(driver.racing_number ?? 0)
                                    </div>

                                    <div class="driver-info">
                                        <div class="driver-name">@driver.driver_name</div>
                                        <div class="driver-team">@driver.teamname</div>
                                        <div class="driver-nationality">@driver.nationality?.ToUpper()</div>
                                    </div>
                                </a>

                                @* Bejelentkezett felhasználó esetén lehetőség van
                                   a pilóta kedvencekhez adására vagy eltávolítására *@
                                @if (isLoggedIn)
                                {
                                    <div class="favorite-container" style="position: absolute; top: 15px; right: 15px; z-index: 100;">
                                        <button @onclick="() => ToggleFavorite(driver.driver_id)"
                                                style="background: none; border: none; cursor: pointer; padding: 5px; outline: none;">
                                            @if (favoriteDriverIds.Contains(driver.driver_id))
                                            {
                                                <span style="color: #ff1801; font-size: 1.4rem; filter: drop-shadow(0 0 5px rgba(255,24,1,0.5));">❤️</span>
                                            }
                                            else
                                            {
                                                <span style="color: rgba(255,255,255,0.4); font-size: 1.4rem;">🤍</span>
                                            }
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }

    </div>

    <footer>
        <p>© 2026 F1 Racing Zone</p>
    </footer>

</div>

@code {

    // A navigációs menü, bejelentkezés és felhasználói adatok állapotai
  
    private bool isLoggedIn = false;
    private List<int> favoriteDriverIds = new();
    private int currentUserId = 1;

    

    // A pilóták csapatok szerinti csoportosított listája
    private IEnumerable<IGrouping<string, DriverDto>> groupedDrivers;
    
    // A teljes pilótalista tárolása
    private List<F1ZoneLibrary.Dto.DriverDto> drivers;

    // Egy pilóta kedvenc státuszának váltása:
    // ha már kedvenc, töröljük; ha még nem, hozzáadjuk
    private async Task ToggleFavorite(int driverId)
    {
        if (!isLoggedIn || currentUserId <= 0) 
        {
            // Opcionálisan: NavManager.NavigateTo("/login");
            return; 
        }

        Console.WriteLine($"Mentés indítása - User: {currentUserId}, Driver: {driverId}");
        if (favoriteDriverIds.Contains(driverId))
        {
            
            var response = await Http.DeleteAsync($"api/favorites/{currentUserId}/{driverId}");

            if (response.IsSuccessStatusCode)
            {
                favoriteDriverIds.Remove(driverId);
            }
        }
        else
        {
            
            var newFavorite = new UserFavorites
            {
                UserId = currentUserId,
                ItemId = driverId,
                ItemType = "Driver"
            };

            var response = await Http.PostAsJsonAsync("api/favorites", newFavorite);

            if (response.IsSuccessStatusCode)
            {
                favoriteDriverIds.Add(driverId);
            }
        }
        StateHasChanged(); 
    }

    // A bejelentkezett felhasználó kedvenc pilótáinak lekérése az API-ból
    private async Task LoadFavorites()
    {
        try
        {
            // 1. Kézzel állítjuk be a GET metódust, hogy véletlenül se legyen kavarodás
            var request = new HttpRequestMessage(HttpMethod.Get, "api/Favorites");
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var allFavs = await response.Content.ReadFromJsonAsync<List<UserFavorites>>();
                if (allFavs != null)
                {
                    favoriteDriverIds = allFavs
                        .Where(f => f.UserId == currentUserId && f.ItemType == "Driver")
                        .Select(f => f.ItemId)
                        .ToList();

                    StateHasChanged();
                }
            }
            else
            {
                // Itt kiírja a pontos hibaüzenetet a konzolra!
                var errorBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"API Hiba ({response.StatusCode}): {errorBody}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kritikus hiba: {ex.Message}");
        }
    }

    // Ellenőrzi, hogy egy adott pilóta szerepel-e a kedvencek között
    private bool IsFavorite(int driverId) => favoriteDriverIds.Contains(driverId);


    // Az oldal inicializálásakor betöltjük a pilótákat,
    // majd csapatnév alapján csoportosítjuk őket
    protected override async Task OnInitializedAsync()
    {
        // Az admin-list-et hívjuk, mert abban benne van a teamname és a bio is
        var allDrivers = await Http.GetFromJsonAsync<List<DriverDto>>("api/drivers/admin-list");
        if (allDrivers != null)
        {
            // Csoportosítás csapat szerint
            groupedDrivers = allDrivers.Where(d => d.teamname != null).GroupBy(d => d.teamname);
        }
    }

    // Ez a függvény a #HEX színből csinál rgba(r,g,b, 0.15) formátumot
    private string HexToRgba(string hex, double opacity)
    {
        if (string.IsNullOrEmpty(hex)) return $"rgba(255,255,255,{opacity})";
        try
        {
            var r = int.Parse(hex.Substring(1, 2), System.Globalization.NumberStyles.HexNumber);
            var g = int.Parse(hex.Substring(3, 2), System.Globalization.NumberStyles.HexNumber);
            var b = int.Parse(hex.Substring(5, 2), System.Globalization.NumberStyles.HexNumber);
            return $"rgba({r}, {g}, {b}, {opacity.ToString().Replace(",", ".")})";
        }
        catch
        {
            return $"rgba(255,255,255,{opacity})";
        }
    }

    // Az első renderelés után kiolvassuk a local storage-ból
    // a bejelentkezési adatokat és szükség esetén betöltjük a kedvenceket
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoggedIn = await localStorage.GetItemAsync<bool>("isAuthenticated");

            if (isLoggedIn)
            {
                
                currentUserId = await localStorage.GetItemAsync<int>("userId");

                
                await LoadFavorites();
            }

            

            StateHasChanged();
        }
    }

}