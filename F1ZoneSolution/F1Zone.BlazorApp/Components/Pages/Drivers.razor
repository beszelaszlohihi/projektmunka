@page "/drivers"
@inject NavigationManager NavManager
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager NavManager

<div class="drivers-body">

    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <a href="/" class="logo">F1<span>ZONE</span></a>
            </div>

            <ul class="nav-links @(isMenuOpen ? "active" : "")">
                <li><a href="/" @onclick="CloseMenu">Kezdőlap</a></li>
                <li><a href="/tracks" @onclick="CloseMenu">Pályák</a></li>
                <li><a href="/drivers" @onclick="CloseMenu">Versenyzők</a></li>
                <li><a href="/schedule" @onclick="CloseMenu">Versenynaptár</a></li>
                <li><a href="/News" @onclick="CloseMenu">Hírek</a></li>
                <li><a href="/regulation_changes" @onclick="CloseMenu">Szabályok</a></li>

                @if (isLoggedIn && userRole == "Admin")
                {
                    <li><a href="/admin" @onclick="CloseMenu">Adatok szerkesztése</a></li>
                }

                <li class="mobile-only">
                    @if (isLoggedIn)
                    {
                        <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                        <button class="login-btn" @onclick="Logout">KIJELENTKEZÉS</button>
                    }
                    else
                    {
                        <button class="login-btn" @onclick="GoToLogin">BEJELENTKEZÉS</button>
                    }
                </li>
            </ul>

            <div class="nav-actions">
                @if (isLoggedIn)
                {

                    @if (userRole == "Admin")
                    {
                        <button class="login-btn desktop-only" @onclick='() => NavManager.NavigateTo("/admin/home")'>ADMIN</button>
                    }
                    <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                    <button class="login-btn desktop-only" @onclick="Logout">KIJELENTKEZÉS</button>
                }
                else
                {
                    <button class="login-btn desktop-only" @onclick="GoToLogin">BEJELENTKEZÉS</button>
                }

                <button class="burger-btn" @onclick="ToggleMenu">
                    @if (isMenuOpen)
                    {
                        <span>&times;</span>
                    }
                    else
                    {
                        <span>&#9776;</span>
                    }
                </button>
            </div>
        </div>
    </nav>

    <section class="hero">
        <h1>Piloták</h1>
        <p>Kattints egy pilotára, hogy többet tudj meg róla</p>
    </section>

    <div class="container">

        @if (groupedDrivers == null)
        {
            <p>Adatok betöltése...</p>
        }
        else
        {
            @foreach (var group in groupedDrivers)
            {
                <div class="team-section">
                    <div class="team-header">
                        @* 1. A csapat függőleges csíkja *@
                        <div class="team-color-bar" style="background: @(group.FirstOrDefault()?.teamcolor ?? "#3671C6")"></div>
                        <h2>@group.Key</h2>
                    </div>

                    <div class="drivers-grid">
                        @foreach (var driver in group)
                        {
                           <a class="driver-card" href="/driver/@driver.driver_name.Replace(" ", "-").ToLower()">
                                @* 2. Háttérben lévő nagy rajtszám - kicsit halványítva, hogy ne nyomja el a nevet *@
                                <span class="driver-number-bg" style="color: @driver.teamcolor; opacity: 0.2;">
                                    @(driver.racing_number ?? 0)
                                </span>

                                @* 3. A körben lévő rajtszám - Adjunk neki egy vékony keretet a csapatszínnel! *@
                                <div class="driver-avatar"
                                     style="background: @(HexToRgba(driver.teamcolor, 0.1));
                            border: 1px solid @driver.teamcolor;
                            color: @driver.teamcolor;
                            box-shadow: 0 0 10px @(HexToRgba(driver.teamcolor, 0.3));">
                                    @(driver.racing_number ?? 0)
                                </div>

                                <div class="driver-info">
                                    <div class="driver-name">@driver.driver_name</div>
                                    <div class="driver-team">@driver.teamname</div>
                                    <div class="driver-nationality">@driver.nationality?.ToUpper()</div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        }

    </div>

    <footer>
        <p>© 2026 F1 Racing Zone</p>
    </footer>

</div>

@code {

    private bool isMenuOpen = false;
    private bool isLoggedIn = false;
    private string userName = "";
    private string userRole = "";

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    private IEnumerable<IGrouping<string, DriverDto>> groupedDrivers;
    private List<F1ZoneLibrary.Dto.DriverDto> drivers;

    protected override async Task OnInitializedAsync()
    {
        // Az admin-list-et hívjuk, mert abban benne van a teamname és a bio is
        var allDrivers = await Http.GetFromJsonAsync<List<DriverDto>>("api/drivers/admin-list");
        if (allDrivers != null)
        {
            // Csoportosítás csapat szerint
            groupedDrivers = allDrivers.Where(d => d.teamname != null).GroupBy(d => d.teamname);
        }
    }

    // Ez a függvény a #HEX színből csinál rgba(r,g,b, 0.15) formátumot
    private string HexToRgba(string hex, double opacity)
    {
        if (string.IsNullOrEmpty(hex)) return $"rgba(255,255,255,{opacity})";
        try
        {
            var r = int.Parse(hex.Substring(1, 2), System.Globalization.NumberStyles.HexNumber);
            var g = int.Parse(hex.Substring(3, 2), System.Globalization.NumberStyles.HexNumber);
            var b = int.Parse(hex.Substring(5, 2), System.Globalization.NumberStyles.HexNumber);
            return $"rgba({r}, {g}, {b}, {opacity.ToString().Replace(",", ".")})";
        }
        catch
        {
            return $"rgba(255,255,255,{opacity})";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) // Csak az első betöltéskor fusson le
        {
            // 1. Kiolvassuk a bejelentkezés állapotát (bool!)
            isLoggedIn = await localStorage.GetItemAsync<bool>("isAuthenticated");

            if (isLoggedIn)
            {
                // 2. Kiolvassuk a nevet és a rangot (string!)
                userName = await localStorage.GetItemAsync<string>("userName");
                userRole = await localStorage.GetItemAsync<string>("userRole");
            }

            // 3. KÉNYSZERÍTJÜK az oldalt, hogy rajzolja újra magát az adatokkal!
            StateHasChanged();
        }
    }

    private void GoToLogin() => NavManager.NavigateTo("/login");
    private async Task Logout()
    {
        await localStorage.ClearAsync();
        userName = "";
        userRole = "";
        NavManager.NavigateTo("/", forceLoad: true);
    }
}