@page "/driver/{id}"
@using F1ZoneLibrary.Dto
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject NavigationManager NavManager
@rendermode InteractiveServer

<div class="driver-detail-page">
    <nav>
        <a href="/f1" class="logo">F1ZONE</a>
        <ul class="nav-links">
            <li><a href="/">Kezdőlap</a></li>
            <li><a href="/tracks">Pályák</a></li>
            <li><a href="/drivers" class="active">Piloták</a></li>
            <li><a href="/schedule">Naptár</a></li>
            <li><a href="/News">Hírek</a></li>
        </ul>
        <button class="login-btn">Bejelentkezés</button>
    </nav>

    <section class="hero" style="text-align:center; padding-top:120px;">
        <div class="hero-accent"></div>
        <h1>@(driver?.driver_name ?? id.Replace("-", " ").ToUpper())</h1>
    </section>

    <div class="detail-content" style="max-width:900px; margin:auto; padding:40px 20px;">
        <h2>Életrajz</h2>
        <div class="bio-card">
            @if (driver == null)
            {
                <div class="loading-box">
                    <p>🏎️ Adatok betöltése a boxutcából...</p>
                </div>
            }
            else
            {
                <p style="white-space:pre-line;">@driver.biography</p>
            }
        </div>

        <h2>Karrier / Szezon statisztika</h2>
        @if (driver != null)
        {
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-value">@driver.wins</div><div class="stat-label">Győzelmek</div></div>
                <div class="stat-card"><div class="stat-value">@driver.podiums</div><div class="stat-label">Pódiumok</div></div>
                <div class="stat-card"><div class="stat-value">@driver.fastest_laps</div><div class="stat-label">Leggyorsabb kör</div></div>
                <div class="stat-card"><div class="stat-value">@driver.championships</div><div class="stat-label">VB címek</div></div>
                <div class="stat-card"><div class="stat-value">@driver.points</div><div class="stat-label">Pontok</div></div>
            </div>
        }
        else
        {
            <p>Statisztikák betöltése...</p>
        }

        <button class="back-btn" @onclick="BackToDrivers">← Vissza a többi pilótához!</button>
    </div>

    <footer>
        <p>© 2026 F1 Racing Zone</p>
    </footer>
</div>

@code {
    [Parameter] public string id { get; set; } = string.Empty;
    private DriverDto? driver;

    protected override async Task OnInitializedAsync()
    {
        await LoadDriver();
    }

    // Ha az URL változik (pl. egyik pilótáról a másikra mész), ez is lefut
    protected override async Task OnParametersSetAsync()
    {
        if (driver != null && driver.driver_name.Replace(" ", "-").ToLower() != id.ToLower())
        {
            await LoadDriver();
        }
    }

    private async Task LoadDriver()
    {
        try
        {
            // Pontosan úgy, ahogy a naptárnál, de egyetlen objektumot várunk
            driver = await Http.GetFromJsonAsync<DriverDto>($"api/drivers/{id}");
           
        }
        catch (Exception ex)
        {
            Console.WriteLine($"API Hiba: {ex.Message}");
            driver = null;
        }
    }

    private void BackToDrivers()
    {
        NavManager.NavigateTo("/drivers");
    }

    public class DriverDto
    {
        [JsonPropertyName("driver_id")]
        public int driver_id { get; set; }

        [JsonPropertyName("driver_name")]
        public string driver_name { get; set; } = "";

        [JsonPropertyName("biography")]
        public string biography { get; set; } = "";

        [JsonPropertyName("championships")]
        public int championships { get; set; }

        [JsonPropertyName("wins")]
        public int wins { get; set; }

        [JsonPropertyName("podiums")]
        public int podiums { get; set; }

        [JsonPropertyName("fastest_laps")]
        public int fastest_laps { get; set; }

        [JsonPropertyName("points")]
        public decimal points { get; set; }
    }
}