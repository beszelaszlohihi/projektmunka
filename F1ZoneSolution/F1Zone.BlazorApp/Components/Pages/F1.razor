@page "/"
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject HttpClient Http


@* Felső navigációs sáv, amely a felhasználó bejelentkezési állapota
  és szerepköre alapján jelenít meg különböző menüpontokat *@
<div class="f1-body">
    

    <section class="hero">
        <h1>Éld át az F1 izgalmát</h1>
        <p>Fedezd fel a világ leglegendásabb versenypályáit, Monaco utcáitól a silverstone-i nagysebességű kanyarokig.</p>
        <a href="/tracks" class="hero-btn">Pályák felfedezése</a>
    </section>


    @* Ha sikerült lekérni a következő futamot, megjelenítjük a visszaszámlálót *@
    @if (nextRace != null)
    {
        <section class="countdown-section">
            <div class="countdown-container">
                <div class="countdown-header">
                    <h2>Következő futam</h2>
                    <p>@nextRace.RaceName • @nextRace.TrackName</p>
                    <span>@nextRace.RaceDate.ToString("yyyy.MM.dd HH:mm")</span>
                </div>

                <div class="countdown-grid">
                    <div class="countdown-item">
                        <span>@timeLeft.Days</span>
                        <small>Nap</small>
                    </div>
                    <div class="countdown-item">
                        <span>@timeLeft.Hours</span>
                        <small>Óra</small>
                    </div>
                    <div class="countdown-item">
                        <span>@timeLeft.Minutes</span>
                        <small>Perc</small>
                    </div>
                    <div class="countdown-item">
                        <span>@timeLeft.Seconds</span>
                        <small>Mp</small>
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="tracks-section">
        <div class="section-header">
            <h2>Legutóbbi futam</h2>
        </div>


        <div class="tracks-grid">
            @* A főoldalra kiemelt pálya megjelenítése.
                Admin számára kattintható, más felhasználóknál csak információs kártya *@
            <article class="track-card @(isLoggedIn && userRole == "Admin" ? "" : "disabled-card")"
                     @onclick="NavigateToAdmin"
                     style="cursor:@(isLoggedIn && userRole == "Admin" ? "pointer" : "not-allowed");">
                <div class="track-image">
                    <img src="@(selectedCircuit?.ImageUrl ?? "https://via.placeholder.com/600x350?text=Nincs+kep")"
                         alt="Selected Circuit">
                </div>
                <div class="track-content">
                    <div class="track-country">@(selectedCircuit?.country ?? "Nincs kiválasztva")</div>
                    <h3 class="track-name">@(selectedCircuit?.circuit_name ?? "Nincs kiválasztott pálya")</h3>
                    <p>@(selectedCircuit?.circuit_description ?? "Az admin még nem választott ki pályát a főoldalra.")</p>
                    <div class="track-stats">
                        <div class="stat">
                            <div class="stat-value">@(selectedCircuit is not null ? $"{selectedCircuit.length_km} km" : "-")</div>
                            <div class="stat-label">Hossz</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">@(selectedCircuit?.turns.ToString() ?? "-")</div>
                            <div class="stat-label">Kanyarok</div>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="section-header" style="margin-top:3rem;">
            <h2>Driver of the Day</h2>
        </div>

        <div class="tracks-grid">
            @* A főoldalra kiemelt versenyző megjelenítése.
                Admin számára kattintható, más felhasználóknál csak információs kártya *@
            <article class="track-card @(isLoggedIn && userRole == "Admin" ? "" : "disabled-card")"
                     @onclick="NavigateToAdmin"
                     style="cursor:@(isLoggedIn && userRole == "Admin" ? "pointer" : "not-allowed");">
                <div class="track-content">
                    <div class="track-country">@(selectedDriver?.nationality ?? "Nincs kiválasztva")</div>
                    <h3 class="track-name">@(selectedDriver?.driver_name ?? "Nincs kiválasztott versenyző")</h3>
                    <p>@(selectedDriver?.biography ?? "Az admin még nem választott ki versenyzőt a főoldalra.")</p>
                    <div class="track-stats">
                        <div class="stat">
                            <div class="stat-value">@(selectedDriver?.wins.ToString() ?? "-")</div>
                            <div class="stat-label">Győzelem</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">@(selectedDriver?.podiums.ToString() ?? "-")</div>
                            <div class="stat-label">Dobogó</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">@(selectedDriver?.championships.ToString() ?? "-")</div>
                            <div class="stat-label">VB cím</div>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <footer>
        <p>© 2026 F1 Racing Zone.</p>
    </footer>
</div>

@code {

    //a felhasználói állapot kezeléséhez szükséges változók
    
    private bool isLoggedIn = false;
    private string userName = "";
    private string userRole = "";

    // A főoldalon kiemelt pálya és versenyző adatai
    private Circuits? selectedCircuit;
    private DriverDto? selectedDriver;

    // A következő futam és a visszaszámláló állapotának tárolása
    private RaceSchedule? nextRace;
    private TimeSpan timeLeft;
    private System.Timers.Timer? countdownTimer;

    // Az oldal inicializálásakor betöltjük a főoldali kiemelt elemeket
    // és a következő futam adatait
    protected override async Task OnInitializedAsync()
    {
        await LoadHomepageSelectionsFromApi();
        await LoadNextRaceAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var currentUserId = await localStorage.GetItemAsync<int>("userId");
            isLoggedIn = (currentUserId > 0);

            
            userRole = await localStorage.GetItemAsync<string>("userRole") ?? "";

            StateHasChanged();
        }
    }
   

    // Az admin által kiválasztott főoldali pálya és versenyző betöltése az API-ból
    private async Task LoadHomepageSelectionsFromApi()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<HomepageSettings>("http://localhost:5007/api/homepagesettings/1");

            if (settings == null)
            {
                selectedCircuit = null;
                selectedDriver = null;
                return;
            }

            var allCircuits = await Http.GetFromJsonAsync<List<Circuits>>("http://localhost:5007/api/circuits") ?? new();
            var allDrivers = await Http.GetFromJsonAsync<List<DriverDto>>("http://localhost:5007/api/drivers/admin-list") ?? new();

            selectedCircuit = allCircuits.FirstOrDefault(c => c.circuit_id == settings.FeaturedCircuitId);
            selectedDriver = allDrivers.FirstOrDefault(d => d.driver_id == settings.FeaturedDriverId);
        }
        catch
        {
            selectedCircuit = null;
            selectedDriver = null;
        }
    }

    // A következő futam adatainak lekérése és a visszaszámláló időzítő elindítása
    private async Task LoadNextRaceAsync()
    {
        try
        {
            nextRace = await Http.GetFromJsonAsync<RaceSchedule>("http://localhost:5007/api/raceschedules/next-race");

            if (nextRace != null)
            {
                UpdateCountdown();

                countdownTimer = new System.Timers.Timer(1000);
                countdownTimer.Elapsed += async (_, _) =>
                {
                    UpdateCountdown();
                    await InvokeAsync(StateHasChanged);
                };
                countdownTimer.Start();
            }
        }
        catch
        {
            nextRace = null;
        }
    }

    // Kiszámolja, mennyi idő van még hátra a következő futam kezdetéig
    private void UpdateCountdown()
    {
        if (nextRace == null)
            return;

        timeLeft = nextRace.RaceDate - DateTime.Now;

        if (timeLeft.TotalSeconds <= 0)
        {
            timeLeft = TimeSpan.Zero;
            countdownTimer?.Stop();
        }
    }

    // Admin jogosultság esetén átnavigál az admin főoldalra
    private async Task NavigateToAdmin()
    {
        var isAuthenticated = await localStorage.GetItemAsync<bool>("isAuthenticated");
        var role = await localStorage.GetItemAsync<string>("userRole");

        if (!isAuthenticated || role != "Admin")
        {
            return;
        }

        NavManager.NavigateTo("/admin/home");
    }

    
    public class HomepageSettings
    {
        public int Id { get; set; }
        public int FeaturedCircuitId { get; set; }
        public int FeaturedDriverId { get; set; }
    }

    public class DriverDto
    {
        public int driver_id { get; set; }
        public string driver_name { get; set; } = "";
        public int wins { get; set; }
        public int championships { get; set; }
        public decimal points { get; set; }
        public string nationality { get; set; } = "";
        public int debut_year { get; set; }
        public int podiums { get; set; }
        public int fastest_laps { get; set; }
        public string biography { get; set; } = "";
        public string TeamName { get; set; } = "";
    }

    public class Circuits
    {
        public int circuit_id { get; set; }
        public string circuit_name { get; set; } = "";
        public string location { get; set; } = "";
        public string country { get; set; } = "";
        public decimal length_km { get; set; }
        public int turns { get; set; }
        public string? ImageUrl { get; set; }
        public string circuit_description { get; set; } = "";
    }

    public class RaceSchedule
    {
        public int Id { get; set; }
        public string RaceName { get; set; } = "";
        public string TrackName { get; set; } = "";
        public DateTime RaceDate { get; set; }
        public string CountryCode { get; set; } = "";
    }
}