@page "/"
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject HttpClient Http

<div class="f1-body">
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <a href="/" class="logo">F1<span>ZONE</span></a>
            </div>

            <ul class="nav-links @(isMenuOpen ? "active" : "")">
                <li><a href="/" @onclick="CloseMenu">Kezdőlap</a></li>
                <li><a href="/tracks" @onclick="CloseMenu">Pályák</a></li>
                <li><a href="/drivers" @onclick="CloseMenu">Versenyzők</a></li>
                <li><a href="/schedule" @onclick="CloseMenu">Versenynaptár</a></li>
                <li><a href="/News" @onclick="CloseMenu">Hírek</a></li>
                <li><a href="/regulation_changes" @onclick="CloseMenu">Szabályok</a></li>

                @if (isLoggedIn)
                {
                    <li><a href="/admin/home" @onclick="CloseMenu">Adatok szerkesztése</a></li>
                }

                <li class="mobile-only">
                    @if (isLoggedIn)
                    {
                        <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                        <button class="login-btn" @onclick="Logout">KIJELENTKEZÉS</button>
                    }
                    else
                    {
                        <button class="login-btn" @onclick="GoToLogin">BEJELENTKEZÉS</button>
                    }
                </li>
            </ul>

            <div class="nav-actions">
                @if (isLoggedIn)
                {
                    <button class="login-btn desktop-only" @onclick='() => NavManager.NavigateTo("/admin/home")'>ADMIN</button>
                    <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                    <button class="login-btn desktop-only" @onclick="Logout">KIJELENTKEZÉS</button>
                }
                else
                {
                    <button class="login-btn desktop-only" @onclick="GoToLogin">BEJELENTKEZÉS</button>
                }

                <button class="burger-btn" @onclick="ToggleMenu">
                    @if (isMenuOpen)
                    {
                        <span>&times;</span>
                    }
                    else
                    {
                        <span>&#9776;</span>
                    }
                </button>
            </div>
        </div>
    </nav>

    <section class="hero">
        <h1>Éld át az F1 izgalmát</h1>
        <p>Fedezd fel a világ leglegendásabb versenypályáit, Monaco utcáitól a silverstone-i nagysebességű kanyarokig.</p>
        <a href="/tracks" class="hero-btn">Pályák felfedezése</a>
    </section>

    <section class="tracks-section">
        <div class="section-header">
            <h2>Legutóbbi futam</h2>
        </div>

        <div class="tracks-grid">
            <article class="track-card @(isLoggedIn ? "" : "disabled-card")"
                     @onclick="NavigateToAdmin"
                     style="cursor:@(isLoggedIn ? "pointer" : "not-allowed");">
                <div class="track-image">
                    <img src="@(selectedCircuit?.ImageUrl ?? "https://via.placeholder.com/600x350?text=Nincs+kep")"
                         alt="Selected Circuit">
                </div>
                <div class="track-content">
                    <div class="track-country">@(selectedCircuit?.country ?? "Nincs kiválasztva")</div>
                    <h3 class="track-name">@(selectedCircuit?.circuit_name ?? "Nincs kiválasztott pálya")</h3>
                    <p>@(selectedCircuit?.circuit_description ?? "Az admin még nem választott ki pályát a főoldalra.")</p>
                    <div class="track-stats">
                        <div class="stat">
                            <div class="stat-value">@(selectedCircuit is not null ? $"{selectedCircuit.length_km} km" : "-")</div>
                            <div class="stat-label">Hossz</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">@(selectedCircuit?.turns.ToString() ?? "-")</div>
                            <div class="stat-label">Kanyarok</div>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="section-header" style="margin-top:3rem;">
            <h2>Driver of the Day</h2>
        </div>

        <div class="tracks-grid">
            <article class="track-card @(isLoggedIn ? "" : "disabled-card")"
                     @onclick="NavigateToAdmin"
                     style="cursor:@(isLoggedIn ? "pointer" : "not-allowed");">
                <div class="track-image">
                    <img src="https://via.placeholder.com/600x350?text=Driver+of+the+Day" alt="Selected Driver">
                </div>
                <div class="track-content">
                    <div class="track-country">@(selectedDriver?.nationality ?? "Nincs kiválasztva")</div>
                    <h3 class="track-name">@(selectedDriver?.driver_name ?? "Nincs kiválasztott versenyző")</h3>
                    <p>@(selectedDriver?.biography ?? "Az admin még nem választott ki versenyzőt a főoldalra.")</p>
                    <div class="track-stats">
                        <div class="stat">
                            <div class="stat-value">@(selectedDriver?.wins.ToString() ?? "-")</div>
                            <div class="stat-label">Győzelem</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">@(selectedDriver?.podiums.ToString() ?? "-")</div>
                            <div class="stat-label">Dobogó</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">@(selectedDriver?.championships.ToString() ?? "-")</div>
                            <div class="stat-label">VB cím</div>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <footer>
        <p>© 2026 F1 Racing Zone.</p>
    </footer>
</div>

@code {
    private bool isMenuOpen = false;
    private bool isLoggedIn = false;
    private string userName = "";

    private Circuits? selectedCircuit;
    private DriverDto? selectedDriver;

    protected override async Task OnInitializedAsync()
    {
        await LoadHomepageSelectionsFromApi();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        isLoggedIn = await localStorage.GetItemAsync<bool>("isAuthenticated");

        if (isLoggedIn)
        {
            userName = await localStorage.GetItemAsync<string>("userName");
        }

        StateHasChanged();
    }

    private async Task LoadHomepageSelectionsFromApi()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<HomepageSettings>("https://localhost:7120/api/homepagesettings/1");

            if (settings == null)
            {
                selectedCircuit = null;
                selectedDriver = null;
                return;
            }

            var allCircuits = await Http.GetFromJsonAsync<List<Circuits>>("https://localhost:7120/api/circuits") ?? new();
            var allDrivers = await Http.GetFromJsonAsync<List<DriverDto>>("https://localhost:7120/api/drivers/admin-list") ?? new();

            selectedCircuit = allCircuits.FirstOrDefault(c => c.circuit_id == settings.FeaturedCircuitId);
            selectedDriver = allDrivers.FirstOrDefault(d => d.driver_id == settings.FeaturedDriverId);
        }
        catch
        {
            selectedCircuit = null;
            selectedDriver = null;
        }
    }

    private async Task NavigateToAdmin()
    {
        var isAuthenticated = await localStorage.GetItemAsync<bool>("isAuthenticated");

        if (!isAuthenticated)
        {
            return;
        }

        NavManager.NavigateTo("/admin/home");
    }

    private void GoToLogin()
    {
        NavManager.NavigateTo("/login");
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
    }

    private async Task Logout()
    {
        await localStorage.RemoveItemAsync("isAuthenticated");
        await localStorage.RemoveItemAsync("userName");

        isLoggedIn = false;
        userName = "";

        NavManager.NavigateTo("/", forceLoad: true);
    }

    public class HomepageSettings
    {
        public int Id { get; set; }
        public int FeaturedCircuitId { get; set; }
        public int FeaturedDriverId { get; set; }
    }

    public class DriverDto
    {
        public int driver_id { get; set; }
        public string driver_name { get; set; } = "";
        public int wins { get; set; }
        public int championships { get; set; }
        public decimal points { get; set; }
        public string nationality { get; set; } = "";
        public int debut_year { get; set; }
        public int podiums { get; set; }
        public int fastest_laps { get; set; }
        public string biography { get; set; } = "";
        public string TeamName { get; set; } = "";
    }

    public class Circuits
    {
        public int circuit_id { get; set; }
        public string circuit_name { get; set; } = "";
        public string location { get; set; } = "";
        public string country { get; set; } = "";
        public decimal length_km { get; set; }
        public int turns { get; set; }
        public string? ImageUrl { get; set; }
        public string circuit_description { get; set; } = "";
    }
}