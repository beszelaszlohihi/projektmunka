@page "/"
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage


<div class="f1-body">
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-brand">
                <a href="/" class="logo">F1<span>ZONE</span></a>
            </div>

            <ul class="nav-links @(isMenuOpen ? "active" : "")">
                <li><a href="/" @onclick="CloseMenu">Kezdőlap</a></li>
                <li><a href="/tracks" @onclick="CloseMenu">Pályák</a></li>
                <li><a href="/drivers" @onclick="CloseMenu">Versenyzők</a></li>
                <li><a href="/schedule" @onclick="CloseMenu">Versenynaptár</a></li>
                <li><a href="/News" @onclick="CloseMenu">Hírek</a></li>
                <li><a href="/regulation_changes" @onclick="CloseMenu">Szabályok</a></li>
                

                <li class="mobile-only">
                    @if (isLoggedIn)
                    {
                        <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                        <button class="logout-btn" @onclick="Logout">KIJELENTKEZÉS</button>
                    }
                    else
                    {
                        <button class="login-btn" @onclick='() => NavManager.NavigateTo("/login")'>BEJELENTKEZÉS</button>
                    }
                </li>
            </ul>
           

            <div class="nav-actions">
                @if (isLoggedIn)
                {
                    <span class="user-welcome">Üdv, <strong>@userName</strong>!</span>
                    <button class="logout-btn" @onclick="Logout">KIJELENTKEZÉS</button>
                }
                else
                {
                    <button class="login-btn desktop-only" @onclick='() => NavManager.NavigateTo("/login")'>BEJELENTKEZÉS</button>
                }

                <button class="burger-btn" @onclick="ToggleMenu">
                    @if (isMenuOpen)
                    {
                        <span>&times;</span>
                    }
                    else
                    {
                        <span>&#9776;</span>
                    }
                </button>
            </div>
        </div>
    </nav>

    <section class="hero">
        <h1>Éld át az F1 izgalmát</h1>
        <p>Fedezd fel a világ leglegendásabb versenypályáit, Monaco utcáitól a silverstone-i nagysebességű kanyarokig.</p>
        <a href="/tracks" class="hero-btn" style="text-decoration: none; display: inline-block;">
            Pályák felfedezése
        </a>
    </section>

    <section class="tracks-section">
        <div class="section-header">
            <h2>Legendás versenypályák</h2>
            <p>Fedezd fel az ikonikus pályákat, amelyek meghatározzák a Forma-1-es versenyzést</p>
        </div>

        <div class="tracks-grid">
            <article class="track-card">
                <div class="track-image">
                    <img src="https://static.domemvm.eu/mfcwebprd/2093/1fadcfed-6772-459b-a053-a63eccc4afec.webp" alt="Monaco Circuit">
                </div>

                <div class="track-content">
                    <div class="track-country">DESH</div>
                    <h3 class="track-name">Tavesz Baktalo testverek</h3>
                    <p>
                        Kedvenc mondata, minden koncerten kotelezoen el kell mondani hogy "HOGY A FASZOMBA EREZZUK MAGUNKAT DRAGA SZEP TESTVEREIM"
                    </p>

                    <div class="track-stats">
                        <div class="stat">
                            <div class="stat-value">67 km</div>
                            <div class="stat-label">Hossz</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">42</div>
                            <div class="stat-label">Körök</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">19</div>
                            <div class="stat-label">Alkaros fuvel toltott cigi</div>
                        </div>
                    </div>
                </div>
            </article>

            <article class="track-card">
                <div class="track-image">
                    <img src="https://s13emagst.akamaized.net/products/16459/16458217/images/res_ee220dcbb786f1d9a20aeeb6032f9783.jpg" alt="Silverstone">
                </div>
                <div class="track-content">
                    <div class="track-country">Magyar tenger</div>
                    <h3 class="track-name">Philips FC8783/09 Performer Silent porzsákos porszívó</h3>
                    <p>Az első album obszcén stílusa tér kicsit vissza ebben a sorban, viszont a továbbiakban már nem jelenik meg hasonló. Minőségi porszívót reklámoz.</p>
                    <div class="track-stats">
                        <div class="stat">
                            <div class="stat-value">87</div>
                            <div class="stat-label">Hossz</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">83</div>
                            <div class="stat-label">Körök</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">09</div>
                            <div class="stat-label">Kanyarok</div>
                        </div>
                    </div>
                </div>
            </article>

        </div>
    </section>

    <footer>
        <p>© 2026 F1 Racing Zone.</p>
    </footer>
</div>

@code {
    private bool isMenuOpen = false;
    private bool isLoggedIn = false;
    private string userName = "";

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Csak az első betöltésnél nézzük meg, később nem kell
        if (firstRender)
        {
            isLoggedIn = await localStorage.GetItemAsync<bool>("isAuthenticated");
            if (isLoggedIn)
            {
                userName = await localStorage.GetItemAsync<string>("userName");
                // Mivel ez a renderelés után történik, szólnunk kell a Blazornak,
                // hogy frissítse a felületet (rajzolja ki a nevet)
                StateHasChanged();
            }
        }
    }

    private async Task Logout()
    {
        await localStorage.ClearAsync(); // Töröljük a mentéseket
        NavManager.NavigateTo("/", forceLoad: true); // Újratöltjük az oldalt
    }

}